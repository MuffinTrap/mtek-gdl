float elapsed = 0.0f;

void main(float deltatime)
{
	elapsed = elapsed + deltatime;
	int center = 200;
	float degrees = elapsed * 15.0f;
	float step = 360/12;
	for (int i = 0; i < 12; i++)
	{
		float s = Sin(degrees);
		float c = Cos(degrees);

		DrawLine(center, center, center + int(s * 100.0f), center + int(c * 100.0f));
		degrees = degrees + step;
	}
}
